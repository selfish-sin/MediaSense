.pytest-tmp/
.coverage
htmlcov/

# Internal project tracking
projects/
restart.bat

# Temp & backups
*.tmp
*.bak
*.bak.*
*.bak-*
*.bak_*

# AI tool directories (运行时数据/索引，不进库；治理层 .trellis 与 .agents/skills 进库)
.codex/
.claude/
.codebuddy/
.agent/
.workbuddy/
.codegraph/
.zcode/
openspec/

# .agents 运行时数据忽略，但 skills/ 共享技能进 git
.agents/*
!.agents/skills/

# Trellis 运行时状态（治理层 scripts/config/workflow/spec/tasks 进 git，只排运行时）
.trellis/.developer
.trellis/.current-task
.trellis/.runtime/
.trellis/.ralph-state.json
.trellis/.agents/
.trellis/.agent-log
.trellis/.session-id
.trellis/.plan-log
.trellis/**/*.tmp
.trellis/.backup-*/
.trellis/**/*.new
.trellis/**/__pycache__/
.trellis/**/*.pyc

# 治理入口文件（进 git，不忽略）
